# Mini Data Platform — environment template
#
# Setup:
#   cp .env.example .env
#   # Edit .env with your real password (never commit .env)
#
# Python loads .env automatically on startup (utils/db.py + python-dotenv).
# Any variable already set in the shell takes precedence over .env.
#
# For psql from terminal (outside Python), optionally:
#   source scripts/load_env.sh       # macOS / Linux
#   . .\scripts\load_env.ps1         # Windows PowerShell
#
# See README.md → "Step 4 — Configure environment variables"

PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_password_here
PGDATABASE=ecommerce_bronze

# Optional: Slack alerts on pipeline failure
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
